---
import { site } from '../data/site';
import LangSwitch from './LangSwitch.astro';
import { t, route } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const d = t(lang);
const path = Astro.url.pathname;

const items = [
  { href: route('services', lang), label: d.nav.services },
  { href: route('work', lang), label: d.nav.work },
  { href: route('about', lang), label: d.nav.about },
  { href: route('contact', lang), label: d.nav.contact },
];

const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="hdr">
  <div class="wrap hdr__in">
    <a class="hdr__brand" href={route('home', lang)} aria-label={`${site.name} — ${d.nav.home}`}>
      <img
        class="hdr__logo"
        src="/assets/icons/android-chrome-192x192.png"
        alt=""
        width="32"
        height="32"
        decoding="async"
      />
      {site.name}
    </a>

    <input type="checkbox" id="navtoggle" class="sr-only hdr__cb" />
    <label for="navtoggle" class="hdr__burger" aria-label={d.nav.menu}>
      <span aria-hidden="true"></span>
    </label>

    <nav class="hdr__nav" aria-label={d.nav.services}>
      {items.map((i) => (
        <a href={i.href} class:list={['hdr__link', { 'is-active': isActive(i.href) }]}>
          {i.label}
        </a>
      ))}
      <LangSwitch lang={lang} />
      <a href={route('contact', lang)} class="btn btn--primary hdr__cta">{d.nav.cta}</a>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--c-border);
    padding-top: env(safe-area-inset-top, 0px);
  }

  .hdr__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    min-height: 66px;
    flex-wrap: wrap;
  }

  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 660;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: var(--c-text);
    text-decoration: none;
  }
  .hdr__logo { width: 30px; height: 30px; flex: none; border-radius: 5px; }

  .hdr__nav {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .hdr__link {
    font-size: var(--fs-sm);
    font-weight: 520;
    color: var(--c-text-soft);
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 1.5px solid transparent;
    transition: color 0.16s var(--ease), border-color 0.16s var(--ease);
    white-space: nowrap;
  }
  .hdr__link:hover { color: var(--c-text); }
  .hdr__link.is-active { color: var(--c-text); border-bottom-color: var(--c-accent); }

  .hdr__cta { padding: 0.5rem 1.05rem; }

  .hdr__burger { display: none; }

  @media (max-width: 800px) {
    .hdr__burger {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      margin-inline-start: auto;
      border: 1px solid var(--c-border-strong);
      border-radius: var(--radius);
      cursor: pointer;
    }
    .hdr__burger span,
    .hdr__burger span::before,
    .hdr__burger span::after {
      content: '';
      display: block;
      width: 17px;
      height: 1.5px;
      background: var(--c-text);
      position: relative;
      transition: transform 0.18s var(--ease), opacity 0.18s var(--ease);
    }
    .hdr__burger span::before { position: absolute; top: -5.5px; }
    .hdr__burger span::after  { position: absolute; top: 5.5px; }

    .hdr__nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-bottom: var(--sp-4);
    }
    .hdr__cb:checked ~ .hdr__nav { display: flex; }
    .hdr__cb:checked ~ .hdr__burger span { transform: rotate(45deg); }
    .hdr__cb:checked ~ .hdr__burger span::before { opacity: 0; }
    .hdr__cb:checked ~ .hdr__burger span::after { transform: rotate(-90deg); top: 0; }

    .hdr__link {
      padding: var(--sp-3) 0;
      border-bottom: 1px solid var(--c-border);
      font-size: var(--fs-base);
    }
    .hdr__link.is-active { border-bottom-color: var(--c-border); color: var(--c-accent); }
    .hdr__cta { margin-top: var(--sp-4); justify-content: center; }
  }

  .hdr__cb:focus-visible ~ .hdr__burger { outline: 2px solid var(--c-accent); outline-offset: 3px; }
</style>
