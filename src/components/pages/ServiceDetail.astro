---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { t, route, serviceUrl, SERVICE_ORDER } from '../../i18n';
import type { Locale } from '../../i18n';

interface Props { lang: Locale; slug: string }
const { lang, slug } = Astro.props;
const d = t(lang);
const s = d.services_data[slug];
const others = SERVICE_ORDER.filter((x) => x !== slug).slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.title,
  description: s.short,
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  areaServed: ['ES', 'CH'],
};
---

<Base lang={lang} title={s.title} description={s.short}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="section">
    <div class="wrap">
      <nav class="crumb" aria-label={d.services.breadcrumb}>
        <a href={route('services', lang)}>{d.nav.services}</a>
        <span aria-hidden="true">/</span>
        <span>{s.title}</span>
      </nav>
      <div class="measure">
        <h1>{s.title}</h1>
        <p class="pain">{s.pain}</p>
        <p class="lead" style="margin-top: var(--sp-5)">{s.intro}</p>
        {s.from && <p class="price">{s.from}</p>}
      </div>
    </div>
  </section>

  <section class="section--tight section--alt section--line">
    <div class="wrap detail">
      <div class="detail__col">
        <h2>{d.services.includesH2}</h2>
        <ul class="ticks">{s.includes.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div class="detail__col">
        <h2>{d.services.signalsH2}</h2>
        <ul class="ticks ticks--warn">{s.signals.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap measure">
      <h2>{d.services.startH2}</h2>
      <p class="lead" style="margin-top: var(--sp-3)">{d.services.startLead}</p>
      <div class="btn-row" style="margin-top: var(--sp-5)">
        <a href={route('contact', lang)} class="btn btn--primary">{d.common.tellUs}</a>
        <a href={`mailto:${site.email}`} class="btn btn--ghost">{site.email}</a>
      </div>
    </div>
  </section>

  <section class="section section--alt section--line">
    <div class="wrap">
      <p class="eyebrow">{d.services.others}</p>
      <div class="grid grid--3" style="margin-top: var(--sp-5)">
        {others.map((o) => (
          <a class="card card--link" href={serviceUrl(o, lang)}>
            <h3>{d.services_data[o].title}</h3>
            <p>{d.services_data[o].short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .crumb { display: flex; gap: var(--sp-2); font-size: var(--fs-sm); color: var(--c-text-mute); margin-bottom: var(--sp-6); }
  .crumb a { text-decoration: none; }
  .pain {
    margin-top: var(--sp-5); font-size: var(--fs-lg); font-style: italic;
    color: var(--c-text-mute); border-left: 3px solid var(--c-accent); padding-left: var(--sp-5);
  }
  .price {
    margin-top: var(--sp-5); font-size: var(--fs-sm); font-weight: 600; color: var(--c-text);
    display: inline-block; border: 1px solid var(--c-border-strong);
    border-radius: var(--radius); padding: 0.35rem 0.85rem;
  }
  .detail { display: grid; gap: var(--sp-7); grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .detail__col h2 { font-size: var(--fs-xl); margin-bottom: var(--sp-4); }
  .ticks { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--sp-3); }
  .ticks li { position: relative; padding-left: 1.75rem; color: var(--c-text-soft); font-size: var(--fs-sm); }
  .ticks li::before {
    content: ''; position: absolute; left: 0; top: 0.5em;
    width: 8px; height: 8px; border-radius: 2px; background: var(--c-ok);
  }
  .ticks--warn li::before { background: var(--c-accent); }
</style>
